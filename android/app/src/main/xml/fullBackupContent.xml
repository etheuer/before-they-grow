<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
  <!-- Before They Grow stores no family-bearing content in cloud backup.
       allowBackup is also set to false in the Android manifest (app.json). -->
  <exclude domain="sharedpref" path="." />
  <exclude domain="database" path="." />
  <exclude domain="file" path="." />
  <exclude domain="external" path="." />
</full-backup-content>